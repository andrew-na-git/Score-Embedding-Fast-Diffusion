# --- Datasets pulled at runtime, not committed ---
cifar-10-batches-py
*.gz
*.gif

# Run outputs: checkpoints, precomputed score fields, per-run reports. Regenerated
# by run.py / run_video.py, and large (a single 16x64x64 score field is ~250 MB).
saves/

# Downloaded evaluation assets: the Kinetics-400 I3D weights and the DAVIS 2017
# archive, ~1.6 GB. Fetch them with `python download_assets.py`, which verifies
# sizes and records SHA-256 digests in assets/MANIFEST.json so a later run can
# confirm it is using identical bytes -- FVD values depend on the exact weights.
assets/

# NOTE: `figures/` is deliberately NOT ignored. The CSV/JSON files in it are the
# measured results the paper cites, and they must be reviewable in diffs.
#
# NOTE: `data/*.pkl` is deliberately NOT ignored. `celeb_data.pkl` and
# `imagenet_data.pkl` are the handpicked images the published experiments run on,
# documented in the README, not generated artifacts.
